<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EdgeBrowsingPower</AssemblyName>
    <RootNamespace>EdgeBrowsingPower</RootNamespace>
    <Version>2.0.16</Version>
    <AssemblyVersion>2.0.16.0</AssemblyVersion>
    <FileVersion>2.0.16.0</FileVersion>
    <PackageVersion>2.0.16</PackageVersion>
    <Product>EdgeBrowsingPower</Product>
    <Company>Microsoft Corporation</Company>
    <Authors>Microsoft Corporation</Authors>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
    <Content Include="..\..\resources\EdgeBrowsingPowerV2.0.15.zip.*"
         Link="%(Filename)%(Extension)"
           CopyToOutputDirectory="PreserveNewest"
           CopyToPublishDirectory="PreserveNewest"
           ExcludeFromSingleFile="true" />
    <Content Include="..\..\resources\Browsing_BatteryLife_v2.0.15_and_YouTubeToS_v1.0.2.pdf"
           Link="Browsing_BatteryLife_v2.0.15_and_YouTubeToS_v1.0.2.pdf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>